# Copiar a .env (en esta misma carpeta, gitignored) antes de `docker compose up`.
# Ver docker-compose.yml de esta carpeta para el prerequisito de red
# (`docker network create station-shared`) antes del primer up.

STARLINK_DB_NAME=starlink_health
STARLINK_DB_USER=starlink_app
# Generar con: python3 -c "import secrets; print(secrets.token_hex(24))"
STARLINK_DB_PASSWORD=

# Nombre del contenedor del broker en infra/mosquitto-vm/ -- no cambiar salvo
# que se renombre ese servicio también.
MQTT_BROKER_HOST=station-mosquitto
MQTT_BROKER_PORT=1883

GRAFANA_ADMIN_USER=admin
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(18))"
# NO usar el valor de ejemplo de ningún repo -- este Grafana queda con IP
# pública y acceso anónimo Viewer habilitado (ver docker-compose.yml).
GRAFANA_ADMIN_PASSWORD=
