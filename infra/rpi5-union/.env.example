# Copiar a .env en esta misma carpeta. Nunca versionar .env (ver .gitignore).

# Clon local del repo de Fede. Relativo a esta carpeta (infra/rpi5-union/) o
# absoluto. Mientras sus ramas no estén en development, hacer checkout de
# feature/meteo-consumer (trae también la persistencia).
TESIS_SENSOR_NODE_DIR=../../../tesis-sensor-node

# Red Docker de la pila de Aldana. Tiene que coincidir con STARLINK_NETWORK_NAME
# del .env de starlink-measurement-station (default: starlink-station-net).
STARLINK_NETWORK_NAME=starlink-station-net

NODE_ID=lit-cordoba-01

# Credenciales de meteo_data. Tienen que coincidir con METEO_DB_* del .env de
# starlink-measurement-station, que es de donde las leen Grafana y el backend.
# Cambiar la contraseña antes de un despliegue que no sea de prueba.
METEO_DB_NAME=meteo_data
METEO_DB_USER=meteo_app
METEO_DB_PASSWORD=meteo_dev_password
