# Copiar a .env (en esta misma carpeta, gitignored) antes de `docker compose up`.

# Puerto externo del broker en la VM (ver docs/CONNECTING.md, tabla de puertos).
MQTT_EXTERNAL_PORT=5883

# Mismas credenciales que se generaron en el passwordfile (docs/CONNECTING.md,
# paso 5) -- el healthcheck del broker se autentica igual que cualquier cliente.
MQTT_HEALTHCHECK_USER=station
MQTT_HEALTHCHECK_PASSWORD=
