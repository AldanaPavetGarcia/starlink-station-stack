# Copiar a .env (gitignored) y ajustar. Ver docs/CONNECTING.md para el detalle.

# IP pública de la VM de la cátedra -- no es secreta, se puede versionar.
MQTT_HOST=35.224.141.221

# Puerto externo real del broker en la VM (remapeado -- 1883 no está en el rango de
# puertos habilitado por la cátedra, ver docs/CONNECTING.md).
MQTT_PORT=5883

# Usuario/password del broker (mosquitto_passwd) -- estos SÍ son secretos, nunca van
# en .env.example con valor real. Pedirlos a Aldana o Fede.
MQTT_USERNAME=
MQTT_PASSWORD=
